<?xml version="1.0" encoding="utf-8" ?>
<log4net>
  <appender name="InfoFileAppender" type="log4net.Appender.FileAppender">
    <file value="E:\kingsemi_log\fa\FALog\loginfo.log" />
    <appendToFile value="true" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level %message%newline" />
    </layout>
  </appender>

  <appender name="DebugFileAppender" type="log4net.Appender.FileAppender">
    <file value="E:\kingsemi_log\fa\FALog\logdebug.log" />
    <appendToFile value="true" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level %message%newline" />
    </layout>
  </appender>

  <appender name="WarnFileAppender" type="log4net.Appender.FileAppender">
    <file value="E:\kingsemi_log\fa\FALog\logwarn.log" />
    <appendToFile value="true" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level %message%newline" />
    </layout>
  </appender>

  <appender name="ErrorFileAppender" type="log4net.Appender.FileAppender">
    <file value="E:\kingsemi_log\fa\FALog\logerror.log" />
    <appendToFile value="true" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level %message%newline" />
    </layout>
  </appender>

  <logger name="loginfo" additivity="false">
    <level value="DEBUG" />
    <appender-ref ref="InfoFileAppender" />
  </logger>

  <logger name="logdebug" additivity="false">
    <level value="DEBUG" />
    <appender-ref ref="DebugFileAppender" />
  </logger>

  <logger name="logwarn" additivity="false">
    <level value="DEBUG" />
    <appender-ref ref="WarnFileAppender" />
  </logger>

  <logger name="logerror" additivity="false">
    <level value="DEBUG" />
    <appender-ref ref="ErrorFileAppender" />
  </logger>

  <root>
    <level value="OFF" />
  </root>
</log4net>
